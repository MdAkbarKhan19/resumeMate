# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database - AWS RDS PostgreSQL
DATABASE_URL=postgresql://username:password@your-rds-endpoint.us-east-1.rds.amazonaws.com:5432/resumemate

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_BUCKET_NAME=resumemate-uploads
AWS_COGNITO_USER_POOL_ID=your-user-pool-id
AWS_COGNITO_CLIENT_ID=your-client-id
AWS_COGNITO_REGION=us-east-1

# ─── AI providers & model routing ───────────────────────────────────────────
# The app routes work across two tiers via src/lib/ai/llm-client.ts:
#   • cheap   → high-volume structured jobs (resume parse, JD extraction,
#               skills/summary/projects). Default: DeepSeek V4 Flash.
#   • quality → the believability-critical experience-bullet rewrite + the
#               reflection (critique→revise) pass. Default: DeepSeek V4 Pro.
#
# AI_PROVIDER selects the default provider. If the chosen provider's key is
# missing, the app automatically falls back to whichever provider IS configured
# (so it keeps working on OpenAI until DEEPSEEK_API_KEY is added, then switches).
AI_PROVIDER=deepseek

# DeepSeek (OpenAI-compatible API). Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Optional model overrides (defaults shown). Note: the deepseek-chat alias maps
# to V4 Flash and is scheduled to deprecate 2026-07-24 — switch to
# deepseek-v4-flash before then.
DEEPSEEK_CHEAP_MODEL=deepseek-chat
DEEPSEEK_QUALITY_MODEL=deepseek-v4-pro

# Reflection (generate→critique→revise on experience bullets). "on" (default)
# or "off" to skip the extra quality pass entirely.
AI_REFLECTION=on

# OpenAI — used as the fallback provider, and still drives a few legacy helpers.
# Privacy note: a user's direct identifiers (name, email, phone, profile URLs)
# are redacted BEFORE any model call (src/lib/ai/pii.ts) regardless of provider.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
# Optional per-tier OpenAI overrides used only when AI_PROVIDER falls back to openai:
# OPENAI_CHEAP_MODEL=gpt-4o-mini
# OPENAI_QUALITY_MODEL=gpt-4o-mini

# Razorpay (Get from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# Razorpay Plan IDs (Create plans in Razorpay Dashboard)
RAZORPAY_TIER1_PLAN_ID="plan_tier1_one_time"
RAZORPAY_TIER2_PLAN_ID="plan_tier2_monthly_subscription"

# Payment amounts (in paise - 1 INR = 100 paise)
RAZORPAY_TIER1_AMOUNT="149900"  # ₹1499
RAZORPAY_TIER2_AMOUNT="199900"  # ₹1999/month

# JWT
JWT_SECRET=your-jwt-secret-key-min-32-chars
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# Feature Flags
ENABLE_AI_FEATURES=true
ENABLE_JD_MATCHING=true
ENABLE_PAYMENTS=true

# Promo override — when set to exactly "true", EVERY user is treated as Pro:
# unlimited resumes / ATS / bullet AI and no watermark on downloads. Used for
# time-boxed "everything free" periods (e.g. friends testing). Leave unset /
# anything-but-"true" for normal plan limits. 100% revertible: remove the line
# (or set false) and restart — no other change needed.
PROMO_FREE_MODE=false

# Monitoring
SENTRY_DSN=your-sentry-dsn
