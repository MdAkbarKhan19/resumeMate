# Copy this to /var/www/resumemate/.env.production on your EC2 instance.
# NEVER commit the real .env.production to git.

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
NEXTAUTH_URL=https://jdsync.com
NEXT_PUBLIC_APP_URL=https://jdsync.com
NEXTAUTH_SECRET=generate-with--openssl-rand-base64-32

# ── Database (Neon Postgres) ──────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/resumemate?sslmode=require

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=generate-with--openssl-rand-base64-32

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_...

# Razorpay subscription plan IDs (create in Razorpay Dashboard → Subscriptions → Plans)
RAZORPAY_PRO_MONTHLY_PLAN_ID=plan_...
RAZORPAY_PRO_QUARTERLY_PLAN_ID=plan_...
RAZORPAY_PRO_ANNUAL_PLAN_ID=plan_...

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_S3_BUCKET=resumemate-uploads

# AWS Cognito (if using)
NEXT_PUBLIC_AWS_COGNITO_USER_POOL_ID=ap-south-1_...
NEXT_PUBLIC_AWS_COGNITO_CLIENT_ID=...

# ── Feature gates (keep false to avoid surprise bills) ────────────────────────
ENABLE_AWS_TEXTRACT=false
ENABLE_AWS_COMPREHEND=false

# ── Puppeteer (on EC2 use system Chromium) ────────────────────────────────────
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=false
