# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database - AWS RDS PostgreSQL
DATABASE_URL=postgresql://username:password@your-rds-endpoint.us-east-1.rds.amazonaws.com:5432/resumemate

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_BUCKET_NAME=resumemate-uploads
AWS_COGNITO_USER_POOL_ID=your-user-pool-id
AWS_COGNITO_CLIENT_ID=your-client-id
AWS_COGNITO_REGION=us-east-1

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo

# Razorpay (Get from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# Razorpay Plan IDs (Create plans in Razorpay Dashboard)
RAZORPAY_TIER1_PLAN_ID="plan_tier1_one_time"
RAZORPAY_TIER2_PLAN_ID="plan_tier2_monthly_subscription"

# Payment amounts (in paise - 1 INR = 100 paise)
RAZORPAY_TIER1_AMOUNT="149900"  # ₹1499
RAZORPAY_TIER2_AMOUNT="199900"  # ₹1999/month

# JWT
JWT_SECRET=your-jwt-secret-key-min-32-chars
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# Feature Flags
ENABLE_AI_FEATURES=true
ENABLE_JD_MATCHING=true
ENABLE_PAYMENTS=true

# Monitoring
SENTRY_DSN=your-sentry-dsn
